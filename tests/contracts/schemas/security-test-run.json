{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema", "run_id", "target_sha256", "plan_sha256", "implementation_sha256", "producer_version", "adapter", "evidence_method", "policy_effect", "independent_certification", "state", "counts", "checks", "evidence", "coverage_limits", "cleanup", "files_analyzed", "started_at", "finished_at"],
  "properties": {
    "schema": {"const": "vulcanary.security-test-run.v1"},
    "run_id": {"type": "string", "format": "uuid"},
    "target_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "plan_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "implementation_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policy_effect": {"const": "none"},
    "independent_certification": {"const": false},
    "evidence_method": {"const": "automated-static-analysis"},
    "state": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN", "DEFERRED"]},
    "files_analyzed": {"type": "integer", "minimum": 0, "maximum": 16},
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "state", "attempted", "executed", "expected", "observed", "reason"],
        "properties": {
          "state": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN", "DEFERRED"]},
          "attempted": {"type": "boolean"}, "executed": {"type": "boolean"}
        },
        "allOf": [
          {"if": {"properties": {"state": {"enum": ["PASS", "FAIL"]}}}, "then": {"properties": {"attempted": {"const": true}, "executed": {"const": true}, "observed": {"type": "object"}}}},
          {"if": {"properties": {"state": {"enum": ["BLOCKED", "NOT_RUN", "DEFERRED"]}}}, "then": {"properties": {"executed": {"const": false}, "observed": {"type": "null"}}}}
        ]
      }
    },
    "evidence": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": false, "required": ["rule", "file", "line"],
        "properties": {"rule": {"type": "string"}, "file": {"type": "string", "pattern": "^source-[0-9]{3}\\.py$"}, "line": {"type": "integer", "minimum": 1}}}
    }
  }
}
